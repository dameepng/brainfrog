# ==============================================================================
# System 2 AI Provider Configuration
# ==============================================================================
# Choose provider: 'antigravity' (Google Login session), 'claude' (Anthropic API),
# 'openai' (OpenAI API), 'openrouter' (OpenRouter API), or 'openai-compatible' (Custom/Local endpoint).
# Default: auto-detected. If you are logged into Google Antigravity, BrainFrog
# uses your Google Auth session directly with NO API key needed!
SYSTEM2_PROVIDER=antigravity

# --- If using Google Antigravity (Google Auth Login) ---
# Models: gemini-3.8-flash-high, gemini-3.7-flash-high, gemini-3.1-pro-high, claude-sonnet-4-6
ANTIGRAVITY_MODEL=gemini-3.8-flash-high
# Optional: path to agy.exe if not in standard ~/.gemini/bin or PATH
# ANTIGRAVITY_BIN=

# --- If using Claude (Anthropic API) ---
# Required only if SYSTEM2_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# Optional: max output tokens for code generation (default: 64000)
# BRAINFROG_MAX_OUTPUT_TOKENS=16000

# --- If using OpenAI API ---
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- If using OpenRouter ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- If using Generic OpenAI-Compatible Endpoint (LocalAI, Ollama, vLLM, DeepSeek) ---
# BRAINFROG_MODEL_API_KEY=your-api-key
# BRAINFROG_MODEL_BASE_URL=https://provider.example/v1
# BRAINFROG_MODEL_NAME=model-name

# ==============================================================================
# System 1 (Jev) - TypeSafe cloud decision engine
# Set your TypeSafe API key (or JEV_API_KEY)
# ==============================================================================
TYPESAFE_API_KEY=
# JEV_API_KEY=

# ==============================================================================
# Messaging Channels Gateway (Optional)
# ==============================================================================
# --- Telegram Channel ---
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Comma-separated list of authorized Telegram user IDs or @usernames (Mandatory for access)
# TELEGRAM_ALLOWED_USERS=12345678,87654321

# --- WhatsApp Channel ---
# WHATSAPP_ENABLED=false
# Comma-separated list of authorized WhatsApp phone numbers with country code
# WHATSAPP_ALLOWED_USERS=+628123456789,+14155552671
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

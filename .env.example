# System 2 (Claude) - required
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the default model (claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: max output tokens for code-generation calls (write_code, review_and_fix).
# Default: 64000 (model ceiling, effectively no cap). Lower this to save cost on simple tasks.
# BRAINFROG_MAX_OUTPUT_TOKENS=16000

# System 1 (Jev) - optional until your TypeSafe waitlist access arrives.
# Leave unset and use `--backend mock` in the meantime.
TYPESAFE_API_KEY=

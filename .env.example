# ==============================================================================
# System 2 AI Provider Configuration
# ==============================================================================
# Choose provider: 'claude' (Anthropic API, default), 'antigravity' (Google Antigravity CLI),
# 'openai' (OpenAI API), 'openrouter' (OpenRouter API), 'sumopod' (Sumopod AI API), or 'openai-compatible' (Custom/Local endpoint).
# Default: 'claude' (or auto-detected from available API keys).
SYSTEM2_PROVIDER=claude

# --- If using Claude (Anthropic API, Recommended Default) ---
# Required when SYSTEM2_PROVIDER=claude (or auto-detected)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# Optional: max output tokens for code generation (default: 64000)
# BRAINFROG_MAX_OUTPUT_TOKENS=16000

# --- If using Google Antigravity (Google Auth Login via agy CLI) ---
# Note: Autonomous invocation of the Antigravity CLI is blocked by default because the installed
# CLI does not provide a technically enforced restricted tool execution boundary.
# To explicitly opt in with full auditability, set BRAINFROG_ALLOW_UNRESTRICTED_ANTIGRAVITY_CLI=1.
# BRAINFROG_ALLOW_UNRESTRICTED_ANTIGRAVITY_CLI=1
# ANTIGRAVITY_MODEL=gemini-3.8-flash-high
# Optional: path to agy.exe if not in standard ~/.gemini/bin or PATH
# ANTIGRAVITY_BIN=

# --- If using OpenAI API ---
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- If using OpenRouter ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- If using Sumopod AI (OpenAI-Compatible API) ---
# SUMOPOD_API_KEY=your-sumopod-api-key
# Models: deepseek-v4-pro (recommended), deepseek-v4.1-flash:netra, glm-5.3-flash, kimi-k3
# SUMOPOD_MODEL=deepseek-v4-pro
# SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# --- If using Generic OpenAI-Compatible Endpoint (LocalAI, Ollama, vLLM, DeepSeek) ---
# BRAINFROG_MODEL_API_KEY=your-api-key
# BRAINFROG_MODEL_BASE_URL=https://provider.example/v1
# BRAINFROG_MODEL_NAME=model-name

# ==============================================================================
# System 1 (Jev) - TypeSafe cloud decision engine
# Set your TypeSafe API key (or JEV_API_KEY)
# ==============================================================================
TYPESAFE_API_KEY=
# JEV_API_KEY=

# ==============================================================================
# Messaging Channels Gateway (Optional)
# ==============================================================================
# --- Telegram Channel ---
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Comma-separated list of authorized Telegram user IDs or @usernames (Mandatory for access)
# TELEGRAM_ALLOWED_USERS=12345678,87654321

# --- WhatsApp Channel ---
# WHATSAPP_ENABLED=false
# Comma-separated list of authorized WhatsApp phone numbers with country code
# WHATSAPP_ALLOWED_USERS=+628123456789,+14155552671
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

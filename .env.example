# ==============================================================================
# System 2 AI Provider Configuration
# ==============================================================================
# Choose provider: 'antigravity' (Google Login session) or 'claude' (Anthropic API).
# Default: auto-detected. If you are logged into Google Antigravity, BrainFrog
# uses your Google Auth session directly with NO API key needed!
SYSTEM2_PROVIDER=antigravity

# --- If using Google Antigravity (Google Auth Login) ---
# Models: gemini-3.8-flash-high, gemini-3.7-flash-high, gemini-3.1-pro-high, claude-sonnet-4-6
ANTIGRAVITY_MODEL=gemini-3.8-flash-high
# Optional: path to agy.exe if not in standard ~/.gemini/bin or PATH
# ANTIGRAVITY_BIN=

# --- If using Claude (Anthropic API) ---
# Required only if SYSTEM2_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# Optional: max output tokens for code generation (default: 64000)
# BRAINFROG_MAX_OUTPUT_TOKENS=16000

# ==============================================================================
# System 1 (Jev) - TypeSafe cloud decision engine
# Set your TypeSafe API key (or JEV_API_KEY)
# ==============================================================================
TYPESAFE_API_KEY=
# JEV_API_KEY=
